{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@zcode/marketing-plugin",
  "version": "0.3.0",
  "private": true,
  "description": "Built-in marketing intelligence plugin: evidence-backed competitor research, creative analysis, and opportunity ranking through the marketing mission tools.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint src --no-ignore",
    "demo:w3": "pnpm build && node scripts/w3-chain.mjs",
    "demo:w3-2": "pnpm build && node scripts/w3-2-sampling-chain.mjs",
    "demo:w3-3": "pnpm build && node scripts/w3-3-run-all.mjs",
    "demo:w3-4": "pnpm build && node scripts/w3-4-panel-e2e.mjs",
    "demo:w4": "pnpm build && node scripts/w4-chain.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@zcode/marketing": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@zcode/provider": "workspace:*",
    "@zcode/provider-node": "workspace:*",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "playwright-core": "1.59.1"
  }
}
